{
  "name": "relevo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare:site": "node scripts/prepare.mjs",
    "dev": "node scripts/prepare.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "browser": "playwright-cli",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test --config playwright.release.config.js",
    "test:desktop": "playwright test --config playwright.desktop.config.js",
    "test:responsive": "playwright test --config playwright.release.config.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "motion": "14.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/cli": "0.1.22",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4"
  }
}
