# Server-only configuration. Never place these values in frontend/Vercel variables.
RELEVO_API_TOKEN=replace-with-random-secret-of-at-least-32-characters
RELEVO_DATABASE_URL=postgresql+psycopg://USERNAME:ENCODED_PASSWORD@HOST:5432/postgres?sslmode=verify-full&sslrootcert=/etc/secrets/postgres-ca.crt
# Worker only; omit database credentials from workers.
RELEVO_API_URL=https://YOUR-API-HOST
RELEVO_DB_POOL_SIZE=3
RELEVO_HEARTBEAT_SECONDS=5
RELEVO_LEASE_SECONDS=15
RELEVO_HTTP_TIMEOUT_SECONDS=2
