# For real local credentials, run: python scripts/configure.py
# This file is a template, not a usable secret.
POSTGRES_PASSWORD=replace-with-generated-local-password
RELEVO_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
RELEVO_DATABASE_URL=postgresql+psycopg://relevo:replace-with-generated-local-password@127.0.0.1:55432/relevo
RELEVO_TEST_DATABASE_URL=postgresql+psycopg://relevo:replace-with-generated-local-password@127.0.0.1:55433/relevo_test
